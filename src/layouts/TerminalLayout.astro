---
import '../styles/tui.css';

interface Props {
  title?: string;
}

const { title = 'YXB // CMD — Sovereign Agentic Command Center & Scheduler' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Local web-based YXB // CMD Sovereign Agentic Command Center & Hierarchical Scheduling Engine"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[#0F0F11] text-[#F4F4F5] font-mono overflow-hidden select-none">
    <!-- Pre-load Interpolated Bezier Curve Diamond Boot Overlay -->
    <div id="yxb-boot-preloader" class="yxb-boot-overlay" aria-hidden="true">
      <div class="relative flex items-center justify-center">
        <!-- Expanding Outer Bezier Diamond Ring -->
        <svg
          width="84"
          height="84"
          viewBox="0 0 64 64"
          fill="none"
          class="absolute yxb-boot-ring"
        >
          <polygon
            points="32,4 60,32 32,60 4,32"
            stroke="#E05C36"
            stroke-width="1.2"
            fill="none"
          />
        </svg>

        <!-- Core YXB // CMD Isometric Diamond Emblem -->
        <div class="yxb-boot-diamond flex flex-col items-center gap-3">
          <svg width="56" height="56" viewBox="0 0 32 32" fill="none">
            <polygon
              points="16,2 30,16 16,30 2,16"
              stroke="#E05C36"
              stroke-width="2"
              fill="rgba(224,92,54,0.16)"
            />
            <polygon
              points="16,7 25,16 16,25 7,16"
              stroke="#F4F4F5"
              stroke-width="1"
              stroke-opacity="0.45"
              fill="none"
            />
            <circle cx="16" cy="16" r="3" fill="#F4F4F5" />
          </svg>
          <div class="text-xs tracking-[0.28em] font-bold text-[#F4F4F5]">
            YXB <span class="text-[#E05C36]">//</span> CMD
          </div>
        </div>
      </div>
    </div>

    <slot />

    <script is:inline>
      // Remove the boot preloader node cleanly after the bezier fade-out finishes
      window.addEventListener('DOMContentLoaded', () => {
        const el = document.getElementById('yxb-boot-preloader');
        if (el) {
          setTimeout(() => {
            el.remove();
          }, 1500);
        }
      });
    </script>
  </body>
</html>
